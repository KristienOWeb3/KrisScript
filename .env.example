# --- SubScript (https://subscriptonarc.com) ---
# Dashboard -> Developers -> API keys. sk_test_ = sandbox, sk_live_ = production.
# Leave BLANK to run Kris's Script in DEV MODE (simulated checkout, no real API calls).
SUBSCRIPT_SECRET_KEY=

# Dashboard -> Developers -> Webhooks. Used to verify x-subscript-signature.
# In dev mode (no secret key) a built-in dev secret is used automatically.
SUBSCRIPT_WEBHOOK_SECRET=

# Set to 1 to publish plan checkouts into SubScript's plan catalogue and DM
# flow. Off by default, and deliberately so: a published MerchantPlan carries no
# environment of its own and no plan query filters on one, so a plan created
# with a sk_test_ key sits in the same public catalogue as live plans and is
# subscribable with real money. Safe and useful on testnet; on mainnet leave it
# off until the catalogue distinguishes environments.
#
# Note that publishing alone only creates the catalogue entry. The DM
# subscription offer is written only when the subscriber's 0x address is also
# sent, which means the account needs a wallet address on file — a vault commit
# id will not do.
SUBSCRIPT_PUBLISH_TO_DM=

# --- DeepSeek ---
# https://platform.deepseek.com -> API keys. Leave blank for demo-mode replies.
DEEPSEEK_API_KEY=

# --- App ---
# Public URL of this app. Must be HTTPS for SubScript success/cancel redirects
# (use an ngrok/cloudflared tunnel URL in dev if you want redirects + real webhooks).
APP_URL=http://localhost:3000

# Random string used to sign session cookies. Change in production.
AUTH_SECRET=change-me-to-a-long-random-string
