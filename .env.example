# --- SubScript (https://subscriptonarc.com) ---
# Dashboard -> Developers -> API keys. sk_test_ = sandbox, sk_live_ = production.
# Leave BLANK to run Kris's Script in DEV MODE (simulated checkout, no real API calls).
SUBSCRIPT_SECRET_KEY=

# Dashboard -> Developers -> Webhooks. Used to verify x-subscript-signature.
# In dev mode (no secret key) a built-in dev secret is used automatically.
SUBSCRIPT_WEBHOOK_SECRET=

# --- DeepSeek ---
# https://platform.deepseek.com -> API keys. Leave blank for demo-mode replies.
DEEPSEEK_API_KEY=

# --- App ---
# Public URL of this app. Must be HTTPS for SubScript success/cancel redirects
# (use an ngrok/cloudflared tunnel URL in dev if you want redirects + real webhooks).
APP_URL=http://localhost:3000

# Random string (32+ chars) used to sign session cookies. REQUIRED in production —
# the server refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Postgres connection string. REQUIRED in production (on the VPS:
# postgres://kris:<password>@localhost:5432/krisscript). Leave blank in
# development to use the embedded PGlite database in data/pglite.
DATABASE_URL=

# Production refuses an sk_test_ key unless this is 1 (a deliberate sandbox deploy).
# ALLOW_TEST_KEY_IN_PRODUCTION=1

# Guards the admin routes: /api/admin/reset (destructive) and
# /api/admin/bootstrap-plans (publishes the three tiers to SubScript's plan
# catalogue). Unset means those routes are DISABLED, not that anything goes —
# there is no fallback secret and no same-origin bypass.
#
# Required for `npm run plans:bootstrap`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_RESET_SECRET=
